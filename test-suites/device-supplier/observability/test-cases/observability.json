[
  {
    "id": "rd-13-observability",
    "name": "Real device \u2014 observability",
    "description": "The device's OpenTelemetry collector pushes telemetry to the CTT (OTLP on port 4318, Prometheus remote write on port 9090). Reported as SKIP when no telemetry arrives: point the device's collector at the CTT host to run it.",
    "crIds": [
      "MARGO-DEV-OBSERVABILITY-006",
      "MARGO-DEV-OBSERVABILITY-010",
      "MARGO-DEV-OBSERVABILITY-023"
    ],
    "optional": true,
    "steps": [
      {
        "id": "rd-13-observability-otlp",
        "name": "Wait for Device OTEL Collector to Push Telemetry (traces or metrics)",
        "crIds": [
          "MARGO-DEV-OBSERVABILITY-006",
          "MARGO-DEV-OBSERVABILITY-010",
          "MARGO-DEV-OBSERVABILITY-023"
        ],
        "method": "GET",
        "endpoint": "/health/telemetry",
        "skip_signing": true,
        "headers": {},
        "expected_status": 200,
        "poll": {
          "interval_seconds": 10,
          "timeout_seconds": 120,
          "until": [
            {
              "field": "otlp_total",
              "operation": "gte",
              "value": 1
            }
          ]
        },
        "validations": [
          {
            "field": "status",
            "operation": "equals",
            "value": "receiving"
          }
        ],
        "extract_context": {
          "otelStatus": "status",
          "otlpTraces": "otlp_traces",
          "promWrites": "prom_writes"
        }
      },
      {
        "id": "rd-13-observability-remote-write",
        "name": "Confirm Prometheus Remote Write Also Received",
        "crIds": [
          "MARGO-DEV-OBSERVABILITY-006"
        ],
        "method": "GET",
        "endpoint": "/health/telemetry",
        "skip_signing": true,
        "headers": {},
        "expected_status": 200,
        "poll": {
          "interval_seconds": 10,
          "timeout_seconds": 120,
          "until": [
            {
              "field": "prom_writes",
              "operation": "gte",
              "value": 1
            }
          ]
        },
        "validations": [
          {
            "field": "prom_writes",
            "operation": "gte",
            "value": 1
          }
        ],
        "extract_context": {}
      }
    ]
  }
]