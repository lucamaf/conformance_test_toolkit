[
  {
    "id": "scenario-capabilities",
    "name": "Capabilities Reporting",
    "description": "POST and PUT capability manifests that match the spec-aligned schema.",
    "steps": [
      {
        "id": "step-2.1",
        "name": "Report Capabilities (create)",
        "method": "PUT",
        "endpoint": "/api/v1/capabilities/device-001",
        "request_body": {
          "properties": {
            "id": "device-001",
            "vendor": "Acme Corp",
            "modelNumber": "ACM-XYZ",
            "serialNumber": "SN-12345",
            "cpus": [
              {
                "cores": 4,
                "architecture": "arm64"
              }
            ],
            "memory": "16Gi",
            "storage": "256Gi",
            "interfaces": [
              {
                "type": "ethernet"
              }
            ],
            "peripherals": [
              {
                "type": "camera"
              }
            ],
            "otelCollector": false,
            "supportedRuntimes": [
              "oci"
            ],
            "supportedDeploymentTypes": [
              "helm",
              "compose"
            ]
          }
        },
        "headers": {},
        "expected_status": 201,
        "validations": [
          {
            "field": "status",
            "operation": "equals",
            "value": "capabilities_received"
          }
        ],
        "extract_context": {},
        "mtls": true,
        "accepted_statuses": [
          200
        ]
      },
      {
        "id": "step-2.2",
        "name": "Report Capabilities (update)",
        "method": "PUT",
        "endpoint": "/api/v1/capabilities/device-001",
        "request_body": {
          "properties": {
            "id": "device-001",
            "vendor": "Acme Corp",
            "modelNumber": "ACM-XYZ",
            "serialNumber": "SN-12345",
            "cpus": [
              {
                "cores": 8,
                "architecture": "amd64"
              }
            ],
            "memory": "32Gi",
            "storage": "512Gi",
            "interfaces": [
              {
                "type": "ethernet"
              },
              {
                "type": "wifi"
              }
            ],
            "peripherals": [],
            "otelCollector": false,
            "supportedRuntimes": [
              "oci"
            ],
            "supportedDeploymentTypes": [
              "helm",
              "compose"
            ]
          }
        },
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "status",
            "operation": "equals",
            "value": "capabilities_received"
          }
        ],
        "extract_context": {},
        "mtls": true
      }
    ]
  },
  {
    "id": "scenario-deployments",
    "name": "Deployment Retrieval And Status",
    "description": "Deployment state retrieval, cache validation, immutable artifact downloads, and status updates.",
    "steps": [
      {
        "id": "step-3.1",
        "name": "Get Current Deployments",
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "manifestVersion",
            "operation": "is_number"
          },
          {
            "field": "bundle.mediaType",
            "operation": "equals",
            "value": "application/vnd.margo.bundle.v1+tar+gzip"
          },
          {
            "field": "bundle.digest",
            "operation": "not_empty"
          },
          {
            "field": "deployments",
            "operation": "is_array"
          },
          {
            "field": "deployments.0.deploymentId",
            "operation": "is_string"
          },
          {
            "field": "bundle.url",
            "operation": "not_empty"
          },
          {
            "field": "deployments.0.url",
            "operation": "not_empty"
          },
          {
            "field": "_headers.ETag",
            "operation": "exists"
          }
        ],
        "extract_context": {
          "manifestEtag": "_headers.ETag",
          "bundleDigest": "bundle.digest",
          "deploymentId": "deployments.0.deploymentId",
          "deploymentDigest": "deployments.0.digest"
        },
        "mtls": true
      },
      {
        "id": "step-3.2",
        "name": "Get Deployments With Matching ETag",
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json",
          "If-None-Match": "{manifestEtag}"
        },
        "expected_status": 304,
        "validations": [],
        "extract_context": {},
        "mtls": true
      },
      {
        "id": "step-3.3",
        "name": "Download Deployment Bundle",
        "method": "GET",
        "endpoint": "/api/v1/bundles/{bundleDigest}",
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "_headers.Content-Type",
            "operation": "contains",
            "value": "application/vnd.margo.bundle.v1+tar+gzip"
          },
          {
            "field": "_headers.Cache-Control",
            "operation": "contains",
            "value": "immutable"
          },
          {
            "field": "_headers.ETag",
            "operation": "exists"
          }
        ],
        "extract_context": {
          "bundleEtag": "_headers.ETag"
        },
        "mtls": true
      },
      {
        "id": "step-3.4",
        "name": "Download Bundle With Matching ETag",
        "method": "GET",
        "endpoint": "/api/v1/bundles/{bundleDigest}",
        "headers": {
          "If-None-Match": "{bundleEtag}"
        },
        "expected_status": 304,
        "validations": [],
        "extract_context": {},
        "mtls": true
      },
      {
        "id": "step-3.5",
        "name": "Download Individual Deployment Manifest",
        "method": "GET",
        "endpoint": "/api/v1/deployments/{deploymentId}/{deploymentDigest}",
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "_headers.Content-Type",
            "operation": "contains",
            "value": "application/yaml"
          },
          {
            "field": "_headers.Cache-Control",
            "operation": "contains",
            "value": "immutable"
          },
          {
            "field": "_headers.Vary",
            "operation": "contains",
            "value": "Accept-Encoding"
          },
          {
            "field": "_headers.ETag",
            "operation": "contains",
            "value": "{deploymentDigest}"
          }
        ],
        "extract_context": {
          "deploymentEtag": "_headers.ETag"
        },
        "mtls": true
      },
      {
        "id": "step-3.6",
        "name": "Download Individual Deployment Manifest With Matching ETag",
        "method": "GET",
        "endpoint": "/api/v1/deployments/{deploymentId}/{deploymentDigest}",
        "headers": {
          "If-None-Match": "{deploymentEtag}"
        },
        "expected_status": 304,
        "validations": [],
        "extract_context": {},
        "mtls": true
      },
      {
        "id": "step-3.7",
        "name": "Report Deployment Status",
        "method": "POST",
        "endpoint": "/api/v1/deployments/{deploymentId}/status",
        "request_body": {
          "deploymentId": "{deploymentId}",
          "status": {
            "state": "installed"
          },
          "components": [
            {
              "name": "app-component-1",
              "state": "installed"
            }
          ],
          "adoptedManifestVersion": 1
        },
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "acknowledgement",
            "operation": "equals",
            "value": "received"
          }
        ],
        "extract_context": {},
        "mtls": true
      },
      {
        "id": "step-3.8",
        "name": "Report Deployment Status: failed, with error details",
        "method": "POST",
        "endpoint": "/api/v1/deployments/{deploymentId}/status",
        "request_body": {
          "deploymentId": "{deploymentId}",
          "status": {
            "state": "failed",
            "error": {
              "code": "IMAGE_PULL_FAILED",
              "source": "device",
              "message": "Conformance test error"
            }
          },
          "components": [
            {
              "name": "app-component-1",
              "state": "failed",
              "error": {
                "code": "IMAGE_PULL_FAILED",
                "source": "device",
                "message": "Conformance test error"
              }
            }
          ],
          "adoptedManifestVersion": 1
        },
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "acknowledgement",
            "operation": "equals",
            "value": "received"
          }
        ],
        "extract_context": {},
        "mtls": true
      },
      {
        "id": "step-3.9",
        "name": "Report Deployment Status: removing",
        "method": "POST",
        "endpoint": "/api/v1/deployments/{deploymentId}/status",
        "request_body": {
          "deploymentId": "{deploymentId}",
          "status": {
            "state": "removing"
          },
          "components": [
            {
              "name": "app-component-1",
              "state": "removing"
            }
          ],
          "adoptedManifestVersion": 1
        },
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "acknowledgement",
            "operation": "equals",
            "value": "received"
          }
        ],
        "extract_context": {},
        "mtls": true
      }
    ]
  }
]