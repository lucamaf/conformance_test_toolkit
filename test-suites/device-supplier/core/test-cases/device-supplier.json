  {
    "id": "rd-10-wfm-trust",
    "name": "Real device \u2014 a WFM the MIS did not certify is refused",
    "description": "For 50 seconds the mock WFM presents a certificate with its own SPIFFE ID that the MIS did not issue. The device must refuse the connection: it must not send any request over it. Afterwards the mock WFM presents its SVID again and the device continues.",
    "crIds": [
      "MARGO-DEV-MANAGEMENTINTERFACE-018",
      "MARGO-DEV-MANAGEMENTINTERFACE-MIAF-002"
    ],
    "steps": [
      {
        "id": "rd-10-wfm-trust-connected",
        "name": "The device is connected to the mock WFM",
        "observe": {
          "path_regex": "^/api/v1/",
          "status": [
            200,
            201,
            204,
            304,
            400,
            403,
            404,
            406,
            422
          ],
          "within_seconds": 120
        },
        "extract_context": {
          "deviceClient": "client",
          "deviceCert": "cert.sha256"
        }
      },
      {
        "id": "rd-10-wfm-trust-arm",
        "name": "Mock WFM: present a certificate the MIS did not issue for 50 seconds",
        "method": "PUT",
        "endpoint": "/api/v1/test/server-identity",
        "mtls": true,
        "request_body": {
          "untrustedSeconds": 50
        },
        "headers": {},
        "expected_status": 200,
        "validations": [],
        "extract_context": {}
      },
      {
        "id": "rd-10-wfm-trust-refused",
        "name": "The device sends no request to a WFM whose certificate the MIS did not issue",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-018",
          "MARGO-DEV-MANAGEMENTINTERFACE-MIAF-002"
        ],
        "observe": {
          "expect": "absent",
          "path_regex": "^/api/v1/",
          "where": [
            {
              "field": "server_identity",
              "operation": "equals",
              "value": "untrusted"
            }
          ],
          "for_seconds": 58,
          "only_if": {
            "method": "TLS",
            "path_regex": "^/handshake-error$",
            "where": [
              {
                "field": "server_identity",
                "operation": "equals",
                "value": "untrusted"
              }
            ]
          },
          "only_if_reason": "the device did not try to connect while the mock WFM presented the untrusted certificate"
        }
      },
      {
        "id": "rd-10-wfm-trust-resumed",
        "name": "The device continues when the WFM presents its SVID again",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-018"
