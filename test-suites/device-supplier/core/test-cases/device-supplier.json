          ],
          "within_seconds": 60,
          "check": [
            {
              "field": "expectations.device-memory",
              "operation": "equals",
              "value": "pass"
            },
            {
              "field": "expectations.device-storage",
              "operation": "equals",
              "value": "pass"
            },
            {
              "field": "expectations.device-cpus",
              "operation": "equals",
              "value": "pass"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "rd-03-desired-state",
    "name": "Real device \u2014 desired state, fetch and status",
    "description": "The device reads its desired-state manifest, fetches the bundle or the deployment it lists by digest, reports the status of the deployment with the manifest version it adopted, and re-reads with the ETag of that manifest.",
    "crIds": [
      "MARGO-DEV-MANAGEMENTINTERFACE-007",
      "MARGO-DEV-MANAGEMENTINTERFACE-015",
      "MARGO-DEV-MANAGEMENTINTERFACE-016",
      "MARGO-DEV-MANAGEMENTINTERFACE-019",
      "MARGO-DEV-MANAGEMENTINTERFACE-RC3-002"
    ],
    "steps": [
      {
        "id": "rd-03-desired-state-connected",
        "name": "The device is connected to the mock WFM",
        "observe": {
          "path_regex": "^/api/v1/",
          "status": [
            200,
            201,
            204,
            304,
            400,
            403,
            404,
            406,
            422
          ],
          "within_seconds": 120
        },
        "extract_context": {
          "deviceClient": "client",
          "deviceCert": "cert.sha256"
        }
      },
      {
        "id": "rd-03-desired-state-read",
        "name": "The device reads the desired-state manifest",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-016"
        ],
        "observe": {
          "method": "GET",
          "path_regex": "^/api/v1/deployments$",
          "status": [
            200,
            304
          ],
          "within_seconds": 180
        }
      },
      {
        "id": "rd-03-desired-state-fetch",
        "name": "The device fetches the bundle or a deployment by its digest",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-016",
          "MARGO-DEV-MANAGEMENTINTERFACE-019"
        ],
        "observe": {
          "method": "GET",
          "path_regex": "^/api/v1/(bundles|deployments/[^/]+)/sha256:[0-9a-f]+$",
          "status": [
            200,
            304
          ],
          "within_seconds": 240
        }
      },
      {
        "id": "rd-03-desired-state-status",
        "name": "The device reports the deployment status and the report passes the mock WFM's validation",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-007",
          "MARGO-DEV-MANAGEMENTINTERFACE-016",
          "MARGO-DEV-MANAGEMENTINTERFACE-RC3-002"
        ],
        "observe": {
          "method": "POST",
          "path_regex": "^/api/v1/deployments/[^/]+/status$",
          "status": [
            200,
            201
          ],
          "within_seconds": 300
        }
      },
      {
        "id": "rd-03-desired-state-etag",
        "name": "The device re-reads the manifest with the ETag of the manifest it adopted (304 Not Modified)",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-015"
        ],
        "observe": {
          "method": "GET",
          "path_regex": "^/api/v1/deployments$",
          "where": [
            {
              "field": "status",
              "operation": "equals",
              "value": 304
            }
          ],
          "status": [
            304
          ],
          "within_seconds": 240
        }
      }
    ]
  },
  {
    "id": "rd-04-deployment-lifecycle",
    "name": "Real device \u2014 a deployment is added and withdrawn",
    "description": "The mock WFM adds a deployment to the desired state and later withdraws it. The device reads each new manifest and reports the status of that deployment after each change.",
    "crIds": [
      "MARGO-DEV-MANAGEMENTINTERFACE-007",
      "MARGO-DEV-MANAGEMENTINTERFACE-016",
      "MARGO-DEV-MANAGEMENTINTERFACE-RC3-002"
    ],
    "steps": [
      {
        "id": "rd-04-deployment-lifecycle-connected",
        "name": "The device is connected to the mock WFM",
        "observe": {
          "path_regex": "^/api/v1/",
          "status": [
            200,
            201,
            204,
            304,
            400,
            403,
            404,
            406,
            422
          ],
          "within_seconds": 120
        },
        "extract_context": {
          "deviceClient": "client",
          "deviceCert": "cert.sha256"
        }
      },
      {
        "id": "rd-04-deployment-lifecycle-add",
        "name": "Mock WFM: add deployment 5f0c1c1e-2b7a-4c58-9d3e-1a2b3c4d5e01 to the desired state",
        "method": "PUT",
        "endpoint": "/api/v1/test/deployments?client={deviceClient}",
        "mtls": true,
        "request_body": {
          "deploymentIds": [
            "a3e2f5dc-912e-494f-8395-52cf3769bc06",
            "5f0c1c1e-2b7a-4c58-9d3e-1a2b3c4d5e01"
          ]
        },
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "manifestVersion",
            "operation": "is_number"
          }
        ],
        "extract_context": {
          "newVersion": "manifestVersion"
        }
      },
      {
        "id": "rd-04-deployment-lifecycle-read",
        "name": "The device reads the new manifest",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-016"
        ],
        "observe": {
          "method": "GET",
          "path_regex": "^/api/v1/deployments$",
          "status": [
            200
          ],
          "within_seconds": 240,
          "where": [
            {
              "field": "response.manifestVersion",
              "operation": "equals",
              "value": "{newVersion}"
            }
          ]
        }
      },
      {
        "id": "rd-04-deployment-lifecycle-status",
        "name": "The device reports status for the added deployment with the new manifest version",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-007",
          "MARGO-DEV-MANAGEMENTINTERFACE-RC3-002"
        ],
        "observe": {
          "method": "POST",
          "path_regex": "^/api/v1/deployments/5f0c1c1e-2b7a-4c58-9d3e-1a2b3c4d5e01/status$",
          "status": [
            200,
            201
          ],
          "within_seconds": 300,
          "check": [
            {
              "field": "body.adoptedManifestVersion",
              "operation": "gte",
              "value": "{newVersion}"
            }
          ]
        }
      },
      {
        "id": "rd-04-deployment-lifecycle-withdraw",
        "name": "Mock WFM: withdraw deployment 5f0c1c1e-2b7a-4c58-9d3e-1a2b3c4d5e01 from the desired state",
        "method": "PUT",
        "endpoint": "/api/v1/test/deployments?client={deviceClient}",
        "mtls": true,
        "request_body": {
          "deploymentIds": [
            "a3e2f5dc-912e-494f-8395-52cf3769bc06"
          ]
        },
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "manifestVersion",
            "operation": "is_number"
          }
        ],
        "extract_context": {
          "newVersion": "manifestVersion"
        }
      },
      {
        "id": "rd-04-deployment-lifecycle-removed",
        "name": "The device reports the withdrawn deployment as removing or removed",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-007"
        ],
        "observe": {
          "method": "POST",
          "path_regex": "^/api/v1/deployments/5f0c1c1e-2b7a-4c58-9d3e-1a2b3c4d5e01/status$",
          "status": [
            200,
            201
          ],
          "within_seconds": 300,
          "where": [
            {
              "field": "body.status.state",
              "operation": "one_of",
              "value": [
                "removing",
                "removed"
              ]
            }
          ]
        }
      }
    ]
  },
  {
    "id": "rd-05-manifest-version",
    "name": "Real device \u2014 a manifest version that does not increase is rejected",
    "description": "The mock WFM serves a changed manifest whose manifestVersion is 1, not greater than the version the device has adopted. The device must reject it and keep its state.",
    "crIds": [
      "MARGO-DEV-MANAGEMENTINTERFACE-010",
      "MARGO-DEV-MANAGEMENTINTERFACE-015"
    ],
    "steps": [
      {
        "id": "rd-05-manifest-version-connected",
        "name": "The device is connected to the mock WFM",
        "observe": {
          "path_regex": "^/api/v1/",
          "status": [
            200,
            201,
            204,
            304,
            400,
            403,
            404,
            406,
            422
          ],
          "within_seconds": 120
        },
        "extract_context": {
          "deviceClient": "client",
          "deviceCert": "cert.sha256"
        }
      },
      {
        "id": "rd-05-manifest-version-arm",
        "name": "Mock WFM: assign deployment 5f0c1c1e-2b7a-4c58-9d3e-1a2b3c4d5e02 in a manifest the device must reject",
        "method": "PUT",
        "endpoint": "/api/v1/test/deployments?client={deviceClient}",
        "mtls": true,
        "request_body": {
          "deploymentIds": [
            "a3e2f5dc-912e-494f-8395-52cf3769bc06",
            "5f0c1c1e-2b7a-4c58-9d3e-1a2b3c4d5e02"
          ],
          "negativeFixture": "non_increasing_manifest_version"
        },
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "manifestVersion",
            "operation": "is_number"
          }
        ],
        "extract_context": {
          "newVersion": "manifestVersion"
        }
      },
      {
        "id": "rd-05-manifest-version-rejected",
        "name": "The device does not act on the rejected manifest (no status report for its new deployment)",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-010"
        ],
        "observe": {
          "expect": "absent",
          "method": "POST",
          "path_regex": "^/api/v1/deployments/5f0c1c1e-2b7a-4c58-9d3e-1a2b3c4d5e02/status$",
          "after_polls": 2,
          "within_seconds": 300,
          "settle_seconds": 20
        }
      },
      {
        "id": "rd-05-manifest-version-state-kept",
        "name": "The device keeps its previous state (it does not send the ETag of the rejected manifest back)",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-010",
          "MARGO-DEV-MANAGEMENTINTERFACE-015"
        ],
        "observe": {
          "expect": "absent",
          "method": "GET",
          "path_regex": "^/api/v1/deployments$",
          "where": [
            {
              "field": "status",
              "operation": "equals",
              "value": 304
            }
          ],
          "after_polls": 3,
          "within_seconds": 300,
          "settle_seconds": 5
        }
      },
      {
        "id": "rd-05-manifest-version-restore",
        "name": "Mock WFM: restore the default desired state",
        "method": "PUT",
        "endpoint": "/api/v1/test/deployments?client={deviceClient}",
        "mtls": true,
        "request_body": {
          "deploymentIds": [
            "a3e2f5dc-912e-494f-8395-52cf3769bc06"
          ]
        },
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "manifestVersion",
            "operation": "is_number"
          }
        ],
        "extract_context": {
          "newVersion": "manifestVersion"
        }
      }
    ]
  },
  {
    "id": "rd-06-digest-algorithm",
    "name": "Real device \u2014 an unsupported digest algorithm is rejected",
    "description": "The mock WFM serves a manifest whose digests use sha512. The device must treat the manifest as invalid, stop processing it and keep its state.",
    "crIds": [
      "MARGO-DEV-MANAGEMENTINTERFACE-008",
      "MARGO-DEV-MANAGEMENTINTERFACE-015"
    ],
    "steps": [
      {
        "id": "rd-06-digest-algorithm-connected",
        "name": "The device is connected to the mock WFM",
        "observe": {
          "path_regex": "^/api/v1/",
          "status": [
