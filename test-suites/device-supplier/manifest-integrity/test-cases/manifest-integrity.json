          "newVersion": "manifestVersion"
        }
      },
      {
        "id": "rd-06-digest-algorithm-rejected",
        "name": "The device does not act on the rejected manifest (no status report for its new deployment)",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-008"
        ],
        "observe": {
          "expect": "absent",
          "method": "POST",
          "path_regex": "^/api/v1/deployments/5f0c1c1e-2b7a-4c58-9d3e-1a2b3c4d5e03/status$",
          "after_polls": 2,
          "within_seconds": 300,
          "settle_seconds": 20
