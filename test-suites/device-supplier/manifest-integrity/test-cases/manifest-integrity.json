  {
    "id": "rd-11-restart",
    "name": "Real device \u2014 state survives a restart",
    "description": "The operator restarts the device during this scenario. After the restart the device must still know the manifest it adopted (it sends its ETag) and must still reject a manifest version that does not increase. Reported as SKIP when the device is not restarted.",
    "crIds": [
      "MARGO-DEV-MANAGEMENTINTERFACE-015",
      "MARGO-DEV-MANAGEMENTINTERFACE-017"
    ],
    "steps": [
      {
        "id": "rd-11-restart-connected",
        "name": "The device is connected to the mock WFM",
        "observe": {
          "path_regex": "^/api/v1/",
          "status": [
            200,
            201,
            204,
            304,
            400,
            403,
            404,
            406,
            422
          ],
          "within_seconds": 120
        },
        "extract_context": {
          "deviceClient": "client",
          "deviceCert": "cert.sha256"
        }
      },
      {
        "id": "rd-11-restart-restarted",
        "name": "The operator restarts the device (it reports its capabilities again)",
        "observe": {
          "method": "PUT",
          "path_regex": "^/api/v1/capabilities/[^/]+$",
          "status": [
            200,
            201
          ],
          "within_seconds": 180,
          "since": "now",
          "mark_after": true,
          "if_absent": "skip_scenario",
          "skip_reason": "the device was not restarted during the run",
          "instruct": "Restart the device under test now (within 3 minutes). To also test SVID rotation, replace its SVID with a re-issued one for the same SPIFFE ID before starting it."
        }
      },
      {
        "id": "rd-11-restart-etag",
        "name": "After the restart the device still sends the ETag of the manifest it adopted",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-015",
          "MARGO-DEV-MANAGEMENTINTERFACE-017"
        ],
        "observe": {
          "method": "GET",
          "path_regex": "^/api/v1/deployments$",
          "status": [
            200,
            304
          ],
          "within_seconds": 180,
          "check": [
            {
              "field": "headers.If-None-Match",
              "operation": "not_empty"
            }
          ]
        }
      },
      {
        "id": "rd-11-restart-arm",
        "name": "Mock WFM: assign deployment 5f0c1c1e-2b7a-4c58-9d3e-1a2b3c4d5e07 in a manifest whose version does not increase",
        "method": "PUT",
        "endpoint": "/api/v1/test/deployments?client={deviceClient}",
        "mtls": true,
        "request_body": {
          "deploymentIds": [
            "a3e2f5dc-912e-494f-8395-52cf3769bc06",
            "5f0c1c1e-2b7a-4c58-9d3e-1a2b3c4d5e07"
          ],
          "negativeFixture": "non_increasing_manifest_version"
        },
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "manifestVersion",
            "operation": "is_number"
          }
        ],
        "extract_context": {
          "newVersion": "manifestVersion"
        }
      },
      {
        "id": "rd-11-restart-rollback",
        "name": "After the restart the device still rejects a manifest version that does not increase",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-017"
        ],
        "observe": {
