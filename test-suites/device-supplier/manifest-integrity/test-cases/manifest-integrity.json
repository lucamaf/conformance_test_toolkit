  {
    "id": "device-mi010-non-increasing-manifest-version",
    "name": "MI-010 \u2014 A manifestVersion Not Strictly Greater Than The Last Must Be Rejected",
    "description": "SUITE SELF-TEST for MARGO-DEV-MANAGEMENTINTERFACE-010. The scenario first reads a manifest at version >= 2 (so the runner records it), then the 'non_increasing_manifest_version' fixture serves a manifest back at version 1; evaluateManifest must reject it as a rollback.",
    "crIds": [
      "MARGO-DEV-MANAGEMENTINTERFACE-010"
    ],
    "steps": [
      {
        "id": "step-mi010-1.1",
        "name": "Assign A Deployment (manifestVersion climbs to 2)",
        "method": "PUT",
        "endpoint": "/api/v1/test/deployments",
        "request_body": {
          "deploymentIds": [
            "self-test-app"
          ]
        },
        "expected_status": 200,
        "mtls": true
      },
      {
        "id": "step-mi010-1.2",
        "name": "GET Deployments \u2014 Establish The Current Version",
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "manifestVersion",
            "operation": "is_number"
          }
        ],
        "mtls": true
      },
      {
        "id": "step-mi010-1.3",
        "name": "Arm non_increasing_manifest_version Fixture",
        "method": "PUT",
        "endpoint": "/api/v1/test/deployments",
        "request_body": {
          "deploymentIds": [
            "self-test-app"
          ],
          "negativeFixture": "non_increasing_manifest_version"
        },
        "expected_status": 200,
        "mtls": true
      },
      {
        "id": "step-mi010-1.4",
        "name": "GET Deployments \u2014 Version Went Backwards, Must Be Rejected",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-010"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "expect_manifest_rejected": true,
        "mtls": true
      },
      {
        "id": "step-mi010-cleanup",
