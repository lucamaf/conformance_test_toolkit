[
  {
    "id": "device-mi008-unsupported-digest-algorithm",
    "name": "MI-008 \u2014 Manifest With Unsupported Digest Algorithm Must Be Rejected",
    "description": "SUITE SELF-TEST for MARGO-DEV-MANAGEMENTINTERFACE-008 ('If a manifest references an unsupported digest algorithm, the client MUST treat the manifest as invalid and abort processing'). The mock is armed with the 'unsupported_digest_algorithm' negative fixture so GET /deployments returns a manifest whose digests use sha512 instead of sha256. The suite then asserts (a) the fixture is actually present in the response and (b) its own manifest-conformance check (expect_manifest_rejected) flags the manifest for rejection. This proves the suite would correctly fail a real device that acted on such a manifest.",
    "crIds": [
      "MARGO-DEV-MANAGEMENTINTERFACE-008"
    ],
    "steps": [
      {
        "id": "step-mi008-1.1",
        "name": "Arm The unsupported_digest_algorithm Negative Fixture",
        "method": "PUT",
        "endpoint": "/api/v1/test/deployments",
        "request_body": {
          "deploymentIds": [
            "mi008-app"
          ],
          "negativeFixture": "unsupported_digest_algorithm"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "negativeFixture",
            "operation": "equals",
            "value": "unsupported_digest_algorithm"
          }
        ],
        "mtls": true
      },
      {
        "id": "step-mi008-1.2",
        "name": "GET Deployments \u2014 Manifest Uses An Unsupported Digest Algorithm And Must Be Rejected",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-008"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "bundle.digest",
            "operation": "contains",
            "value": "sha512:"
          },
          {
            "field": "deployments.0.digest",
            "operation": "contains",
            "value": "sha512:"
          }
        ],
        "expect_manifest_rejected": true,
        "mtls": true
      },
      {
        "id": "step-mi008-cleanup",
        "name": "Cleanup: Restore Default Deployment And Clear Fixture",
        "method": "PUT",
        "endpoint": "/api/v1/test/deployments",
        "request_body": {
          "deploymentIds": [
            "self-test-app"
          ],
          "negativeFixture": ""
        },
        "expected_status": 200,
        "validations": [],
        "mtls": true
      }
    ]
  },
