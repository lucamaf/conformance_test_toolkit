        "observe": {
          "path_regex": "^/api/v1/",
          "status": [
            200,
            201,
            204,
            304,
            400,
            403,
            404,
            406,
            422
          ],
          "within_seconds": 120
        },
        "extract_context": {
          "deviceClient": "client",
          "deviceCert": "cert.sha256"
        }
      },
      {
        "id": "rd-07-bundle-content-arm",
        "name": "Mock WFM: assign deployment 5f0c1c1e-2b7a-4c58-9d3e-1a2b3c4d5e04 in a manifest the device must reject",
        "method": "PUT",
        "endpoint": "/api/v1/test/deployments?client={deviceClient}",
        "mtls": true,
        "request_body": {
          "deploymentIds": [
            "a3e2f5dc-912e-494f-8395-52cf3769bc06",
            "5f0c1c1e-2b7a-4c58-9d3e-1a2b3c4d5e04"
          ],
          "negativeFixture": "bundle_content_tampered"
        },
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "manifestVersion",
            "operation": "is_number"
          }
        ],
        "extract_context": {
          "newVersion": "manifestVersion"
        }
      },
      {
        "id": "rd-07-bundle-content-rejected",
        "name": "The device does not act on the rejected manifest (no status report for its new deployment)",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-006",
          "MARGO-DEV-MANAGEMENTINTERFACE-009",
          "MARGO-DEV-MANAGEMENTINTERFACE-019"
        ],
        "observe": {
          "expect": "absent",
          "method": "POST",
          "path_regex": "^/api/v1/deployments/5f0c1c1e-2b7a-4c58-9d3e-1a2b3c4d5e04/status$",
          "after_polls": 2,
          "within_seconds": 300,
          "settle_seconds": 20,
          "only_if": {
            "method": "GET",
            "path_regex": "^/api/v1/bundles/",
            "where": [
              {
                "field": "status",
                "operation": "equals",
                "value": 200
              }
            ]
          },
          "only_if_reason": "the device did not download the bundle archive, so it was not faced with content that does not match the digest"
        }
      },
      {
        "id": "rd-07-bundle-content-state-kept",
        "name": "The device keeps its previous state (it does not send the ETag of the rejected manifest back)",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-009",
          "MARGO-DEV-MANAGEMENTINTERFACE-015"
        ],
        "observe": {
          "expect": "absent",
          "method": "GET",
          "path_regex": "^/api/v1/deployments$",
          "where": [
            {
              "field": "status",
              "operation": "equals",
              "value": 304
            }
          ],
          "after_polls": 3,
          "within_seconds": 300,
          "settle_seconds": 5,
          "only_if": {
            "method": "GET",
            "path_regex": "^/api/v1/bundles/",
            "where": [
              {
                "field": "status",
                "operation": "equals",
                "value": 200
              }
            ]
          },
          "only_if_reason": "the device did not download the bundle archive, so it was not faced with content that does not match the digest"
        }
      },
      {
        "id": "rd-07-bundle-content-restore",
        "name": "Mock WFM: restore the default desired state",
        "method": "PUT",
        "endpoint": "/api/v1/test/deployments?client={deviceClient}",
        "mtls": true,
        "request_body": {
          "deploymentIds": [
            "a3e2f5dc-912e-494f-8395-52cf3769bc06"
          ]
        },
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "manifestVersion",
            "operation": "is_number"
          }
        ],
        "extract_context": {
          "newVersion": "manifestVersion"
        }
      }
    ]
  },
