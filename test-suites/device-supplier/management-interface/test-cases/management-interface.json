  {
    "id": "device-core-manifest-semantics",
    "name": "Desired State \u2014 Default Negotiation and Zero-Deployment Manifest",
    "description": "Per docs.margo.org/specification/margo-management-interface/desired-state: (1) the WFM (here, our mock server) MUST default to application/vnd.margo.manifest.v1+json when the Accept header is omitted entirely, not just when it's the exact expected value; (2) when a client has zero deployments assigned, the manifest's deployments field MUST still be a valid (empty) array. Both are edge cases the other device-supplier groups don't exercise directly. Note: the spec also requires the manifest's bundle field to be explicit null (not omitted) when deployments is empty \u2014 not independently verified here, because this suite's validation engine can't distinguish a field that's present-but-null from one that's absent (both read as Go/JS nil); confirmed instead by reading the mock server's response-construction code directly.",
    "crIds": [
      "MARGO-DEV-MANAGEMENTINTERFACE-016"
    ],
    "steps": [
      {
        "id": "step-core-2.1",
        "name": "Get Deployments With No Accept Header \u2014 Defaults To Manifest Format",
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "manifestVersion",
            "operation": "is_number"
          },
          {
            "field": "_headers.Content-Type",
            "operation": "contains",
            "value": "application/vnd.margo.manifest.v1+json"
          }
        ],
        "extract_context": {},
        "mtls": true,
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-016"
        ]
      },
      {
        "id": "step-core-2.2",
        "name": "Reset Desired State To Empty (test-control)",
        "method": "PUT",
        "endpoint": "/api/v1/test/deployments",
        "request_body": {
          "deploymentIds": []
        },
        "headers": {},
        "expected_status": 200,
        "validations": [],
        "extract_context": {},
        "mtls": true
      },
      {
        "id": "step-core-2.3",
        "name": "Get Deployments \u2014 Zero Deployments Still Returns A Valid (Empty) Manifest",
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "manifestVersion",
            "operation": "is_number"
          },
          {
            "field": "deployments",
            "operation": "is_array"
          }
        ],
        "extract_context": {},
        "mtls": true,
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-016"
        ]
      },
      {
        "id": "step-core-2-cleanup",
        "name": "Cleanup: Restore Default Deployment",
        "method": "PUT",
        "endpoint": "/api/v1/test/deployments",
        "request_body": {
          "deploymentIds": [
            "self-test-app"
          ],
          "negativeFixture": ""
        },
        "expected_status": 200,
        "validations": [],
        "mtls": true
      }
    ]
  },
