      "MARGO-DEV-MANAGEMENTINTERFACE-016"
    ],
    "steps": [
      {
        "id": "step-2.1",
        "name": "Report Capabilities (create)",
        "crIds": [
          "MARGO-DEV-APPLICATIONDESCRIPTION-001",
          "MARGO-DEV-APPLICATIONDESCRIPTION-002",
          "MARGO-DEV-APPLICATIONDESCRIPTION-003",
          "MARGO-DEV-DEPLOYMENT-002",
