  {
    "id": "scenario-deployments",
    "name": "Deployment Retrieval And Status",
    "description": "Deployment state retrieval, cache validation, immutable artifact downloads, and status updates.",
    "crIds": [
      "MARGO-DEV-MANAGEMENTINTERFACE-007",
      "MARGO-DEV-MANAGEMENTINTERFACE-016",
      "MARGO-DEV-MANAGEMENTINTERFACE-019"
    ],
    "steps": [
      {
        "id": "step-3.1",
        "name": "Get Current Deployments",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-016"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "manifestVersion",
            "operation": "is_number"
          },
          {
            "field": "bundle.mediaType",
            "operation": "equals",
            "value": "application/vnd.margo.bundle.v1+tar+gzip"
          },
          {
            "field": "bundle.digest",
            "operation": "not_empty"
          },
          {
            "field": "deployments",
            "operation": "is_array"
          },
          {
            "field": "deployments.0.deploymentId",
            "operation": "is_string"
          },
          {
            "field": "bundle.url",
            "operation": "not_empty"
          },
          {
            "field": "deployments.0.url",
            "operation": "not_empty"
          },
          {
            "field": "_headers.ETag",
            "operation": "exists"
          }
        ],
        "extract_context": {
          "manifestEtag": "_headers.ETag",
          "bundleDigest": "bundle.digest",
          "deploymentId": "deployments.0.deploymentId",
          "deploymentDigest": "deployments.0.digest"
        },
        "mtls": true
      },
      {
        "id": "step-3.2",
        "name": "Get Deployments With Matching ETag",
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json",
          "If-None-Match": "{manifestEtag}"
        },
        "expected_status": 304,
        "validations": [],
        "extract_context": {},
        "mtls": true,
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-016"
        ]
      },
      {
        "id": "step-3.3",
        "name": "Download Deployment Bundle",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-016",
          "MARGO-DEV-MANAGEMENTINTERFACE-019"
        ],
        "method": "GET",
        "endpoint": "/api/v1/bundles/{bundleDigest}",
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "_headers.Content-Type",
            "operation": "contains",
            "value": "application/vnd.margo.bundle.v1+tar+gzip"
          },
          {
            "field": "_headers.Cache-Control",
            "operation": "contains",
            "value": "immutable"
          },
          {
            "field": "_headers.ETag",
            "operation": "exists"
          }
        ],
        "extract_context": {
          "bundleEtag": "_headers.ETag"
        },
        "mtls": true
      },
      {
        "id": "step-3.4",
        "name": "Download Bundle With Matching ETag",
        "method": "GET",
        "endpoint": "/api/v1/bundles/{bundleDigest}",
        "headers": {
          "If-None-Match": "{bundleEtag}"
        },
        "expected_status": 304,
        "validations": [],
        "extract_context": {},
        "mtls": true,
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-016"
        ]
      },
      {
        "id": "step-3.5",
        "name": "Download Individual Deployment Manifest",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-016",
          "MARGO-DEV-MANAGEMENTINTERFACE-019"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments/{deploymentId}/{deploymentDigest}",
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "_headers.Content-Type",
            "operation": "contains",
            "value": "application/yaml"
          },
          {
            "field": "_headers.Cache-Control",
            "operation": "contains",
            "value": "immutable"
          },
          {
            "field": "_headers.Vary",
            "operation": "contains",
            "value": "Accept-Encoding"
          },
          {
            "field": "_headers.ETag",
            "operation": "contains",
            "value": "{deploymentDigest}"
          }
        ],
        "extract_context": {
          "deploymentEtag": "_headers.ETag"
        },
        "mtls": true
      },
      {
        "id": "step-3.6",
        "name": "Download Individual Deployment Manifest With Matching ETag",
        "method": "GET",
        "endpoint": "/api/v1/deployments/{deploymentId}/{deploymentDigest}",
        "headers": {
          "If-None-Match": "{deploymentEtag}"
        },
        "expected_status": 304,
        "validations": [],
        "extract_context": {},
        "mtls": true,
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-016"
        ]
      },
      {
        "id": "step-3.7",
        "name": "Report Deployment Status",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-007",
          "MARGO-DEV-MANAGEMENTINTERFACE-016"
        ],
        "method": "POST",
        "endpoint": "/api/v1/deployments/{deploymentId}/status",
        "request_body": {
          "deploymentId": "{deploymentId}",
          "status": {
            "state": "installed"
          },
          "components": [
            {
              "name": "app-component-1",
              "state": "installed"
            }
          ],
          "adoptedManifestVersion": 1
        },
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "acknowledgement",
            "operation": "equals",
            "value": "received"
          }
        ],
        "extract_context": {},
        "mtls": true
      },
      {
        "id": "step-3.8",
        "name": "Report Deployment Status: failed, with error details",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-007",
          "MARGO-DEV-MANAGEMENTINTERFACE-016"
        ],
        "method": "POST",
        "endpoint": "/api/v1/deployments/{deploymentId}/status",
        "request_body": {
          "deploymentId": "{deploymentId}",
          "status": {
            "state": "failed",
            "error": {
              "code": "IMAGE_PULL_FAILED",
              "source": "device",
              "message": "Conformance test error"
            }
          },
          "components": [
            {
              "name": "app-component-1",
              "state": "failed",
              "error": {
                "code": "IMAGE_PULL_FAILED",
                "source": "device",
                "message": "Conformance test error"
              }
            }
          ],
          "adoptedManifestVersion": 1
        },
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "acknowledgement",
            "operation": "equals",
            "value": "received"
          }
        ],
        "extract_context": {},
        "mtls": true
      },
      {
        "id": "step-3.9",
        "name": "Report Deployment Status: removing",
        "crIds": [
          "MARGO-DEV-MANAGEMENTINTERFACE-007",
          "MARGO-DEV-MANAGEMENTINTERFACE-016"
        ],
        "method": "POST",
        "endpoint": "/api/v1/deployments/{deploymentId}/status",
        "request_body": {
          "deploymentId": "{deploymentId}",
          "status": {
            "state": "removing"
          },
          "components": [
            {
              "name": "app-component-1",
              "state": "removing"
            }
          ],
          "adoptedManifestVersion": 1
        },
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "acknowledgement",
            "operation": "equals",
            "value": "received"
          }
        ],
        "extract_context": {},
        "mtls": true
      }
    ]
  },
