[
  {
    "id": "flex-bundle",
    "name": "Flexible Order \u2014 Bundle Download",
    "description": "Self-contained: the first step is a local GET-deployments setup (scenario-scoped, not shared) to obtain bundleDigest, so this scenario never depends on flex-desired-state having run first. Runs under this suite's static mTLS identity, no shared onboarding context needed.",
    "steps": [
      {
        "id": "flex-bundle-setup-get-deployments",
        "name": "Get Current Deployments (local setup)",
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "bundle.digest",
            "operation": "not_empty"
          }
        ],
        "extract_context": {
          "bundleDigest": "bundle.digest"
        },
        "mtls": true
      },
      {
        "id": "flex-bundle-download",
        "name": "Download Deployment Bundle",
        "method": "GET",
        "endpoint": "/api/v1/bundles/{bundleDigest}",
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "_headers.Content-Type",
            "operation": "contains",
            "value": "application/vnd.margo.bundle.v1+tar+gzip"
          },
          {
            "field": "_headers.Cache-Control",
            "operation": "contains",
            "value": "immutable"
          },
          {
            "field": "_headers.ETag",
            "operation": "exists"
          }
        ],
        "extract_context": {
          "bundleEtag": "_headers.ETag"
        },
        "mtls": true
      },
      {
        "id": "flex-bundle-etag-match",
        "name": "Download Bundle With Matching ETag",
        "method": "GET",
        "endpoint": "/api/v1/bundles/{bundleDigest}",
        "headers": {
          "If-None-Match": "{bundleEtag}"
        },
        "expected_status": 304,
        "validations": [],
        "extract_context": {},
        "mtls": true
      },
      {
        "id": "flex-bundle-reject-wrong-digest",
        "name": "Reject Bundle Download With Wrong Digest",
        "method": "GET",
        "endpoint": "/api/v1/bundles/not-the-right-digest",
        "headers": {},
        "expected_status": 404,
        "validations": [
          {
            "field": "error",
            "operation": "contains",
            "value": "Bundle not found"
          }
        ],
        "extract_context": {},
        "mtls": true
      }
    ]
  },
