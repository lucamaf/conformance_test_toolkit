      },
      {
        "id": "flex-reconciliation-status-installing",
        "name": "Report Status: installing",
        "method": "POST",
        "endpoint": "/api/v1/deployments/a3e2f5dc-912e-494f-8395-52cf3769bc06/status",
        "request_body": {
          "deploymentId": "a3e2f5dc-912e-494f-8395-52cf3769bc06",
          "status": {
            "state": "installing"
          },
          "components": [
            {
              "name": "app-component-1",
              "state": "installing"
            }
          ],
          "adoptedManifestVersion": 1
        },
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "acknowledgement",
            "operation": "equals",
            "value": "received"
          }
        ],
        "extract_context": {},
        "mtls": true
      },
      {
        "id": "flex-reconciliation-status-installed",
        "name": "Report Status: installed",
        "method": "POST",
        "endpoint": "/api/v1/deployments/a3e2f5dc-912e-494f-8395-52cf3769bc06/status",
        "request_body": {
          "deploymentId": "a3e2f5dc-912e-494f-8395-52cf3769bc06",
          "status": {
            "state": "installed"
          },
          "components": [
            {
              "name": "app-component-1",
