  {
    "id": "flex-status",
    "name": "Flexible Order \u2014 Deployment Status Reporting",
    "description": "Self-contained: the first step is a local GET-deployments setup (scenario-scoped, not shared) to obtain deploymentId, so this scenario never depends on flex-desired-state having run first. Runs under this suite's static mTLS identity, no shared onboarding context needed.",
    "steps": [
      {
        "id": "flex-status-setup",
        "name": "Get Current Deployments (local setup)",
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "deployments.0.deploymentId",
            "operation": "exists"
          }
        ],
        "extract_context": {
          "deploymentId": "deployments.0.deploymentId"
        },
        "mtls": true
      },
      {
        "id": "flex-status-post-installed",
        "name": "Report Deployment Status",
        "method": "POST",
        "endpoint": "/api/v1/deployments/{deploymentId}/status",
        "request_body": {
          "deploymentId": "{deploymentId}",
          "status": {
            "state": "installed"
          },
          "components": [
            {
              "name": "app-component-1",
              "state": "installed"
            }
          ],
          "adoptedManifestVersion": 1
        },
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "acknowledgement",
            "operation": "equals",
            "value": "received"
          }
        ],
        "extract_context": {},
        "mtls": true
      },
      {
        "id": "flex-status-post-with-deviceid",
        "name": "Report Deployment Status With Optional deviceId (now type-checked)",
        "method": "POST",
        "endpoint": "/api/v1/deployments/{deploymentId}/status",
        "request_body": {
          "deploymentId": "{deploymentId}",
          "deviceId": "flex-device-001",
          "status": {
            "state": "installing"
          },
