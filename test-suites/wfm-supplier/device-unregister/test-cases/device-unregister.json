[
  {
    "id": "wfm-unregister-device",
    "name": "Device Capabilities — Unregister A Device (DELETE)",
    "crIds": [
      "MARGO-WFM-MANAGEMENTINTERFACE-023"
    ],
    "description": "DELETE /api/v1/capabilities/{deviceId} removes a device the client registered: 204 the first time, then 404 with the device-not-found problem type because the device no longer exists. Uses its own deviceId so no other scenario's device is touched. Not part of the core group — select the device-unregister group to run it.",
    "steps": [
      {
        "id": "wfm-unreg-1",
        "name": "Register A Device To Unregister",
        "method": "PUT",
        "endpoint": "/api/v1/capabilities/wfm-unregister-test-device",
        "mtls": true,
        "headers": {},
        "request_body": {
          "properties": {
            "id": "wfm-unregister-test-device",
            "vendor": "Conformance Test Suite",
            "modelNumber": "CTS-WFMUNREG-1",
            "serialNumber": "SN-WFMUNREG-001",
            "cpus": [
              {
                "cores": 4,
                "architecture": "arm64"
              }
            ],
            "memory": "16Gi",
            "storage": "256Gi",
            "interfaces": [
              {
                "type": "ethernet"
              }
            ],
            "peripherals": [],
            "otelCollector": false,
            "supportedRuntimes": [
              "oci"
            ],
            "supportedDeploymentTypes": [
              "helm",
              "compose"
            ]
          }
        },
        "expected_status": 201,
        "accepted_statuses": [
          200
        ],
        "validations": [],
        "extract_context": {}
      },
      {
        "id": "wfm-unreg-2",
        "name": "Unregister The Device — 204",
        "method": "DELETE",
        "endpoint": "/api/v1/capabilities/wfm-unregister-test-device",
        "mtls": true,
        "headers": {},
        "expected_status": 204,
        "validations": [],
        "extract_context": {}
      },
      {
        "id": "wfm-unreg-3",
        "name": "Unregister The Same Device Again — 404 device-not-found",
        "method": "DELETE",
        "endpoint": "/api/v1/capabilities/wfm-unregister-test-device",
        "mtls": true,
        "headers": {},
        "expected_status": 404,
        "validations": [
          {
            "field": "_headers.content-type",
            "operation": "contains",
            "value": "application/problem+json"
          },
          {
            "field": "type",
            "operation": "equals",
            "value": "https://docs.margo.org/specification/problem-types#device-not-found"
          }
        ],
        "extract_context": {}
      }
    ]
  }
]
