        "endpoint": "/api/v1/capabilities/wfm-core-device",
        "mtls": true,
        "request_body": {
          "properties": {
            "id": "wfm-core-device",
            "vendor": "Conformance Test Suite",
            "modelNumber": "CTS-WFMCORE-1",
            "serialNumber": "SN-WFMCORE-001",
            "cpus": [
              {
                "cores": 4,
                "architecture": "arm64"
              }
            ],
            "memory": "16Gi",
            "storage": "256Gi",
            "interfaces": [
              {
                "type": "ethernet"
              }
            ],
            "peripherals": [],
            "otelCollector": false,
            "supportedRuntimes": [
              "oci"
            ],
            "supportedDeploymentTypes": [
              "helm",
              "compose"
            ]
          }
        },
        "headers": {},
        "expected_status": 201,
        "validations": [],
        "extract_context": {},
        "accepted_statuses": [
          200
        ]
      },
      {
        "id": "wfm-core-cap-2",
        "name": "Update Device Capabilities (same deviceId, second call)",
        "crIds": [
