  {
    "id": "wfm-core-desired-state",
    "name": "Desired State — Retrieval, Content Negotiation, Digest-Addressed Fetches",
    "crIds": [
      "MARGO-WFM-MANAGEMENTINTERFACE-004",
      "MARGO-WFM-MANAGEMENTINTERFACE-006",
      "MARGO-WFM-MANAGEMENTINTERFACE-007",
      "MARGO-WFM-MANAGEMENTINTERFACE-009",
      "MARGO-WFM-MANAGEMENTINTERFACE-027",
      "MARGO-WFM-MANAGEMENTINTERFACE-030",
      "MARGO-WFM-MANAGEMENTINTERFACE-033",
      "MARGO-WFM-MANAGEMENTINTERFACE-034",
      "MARGO-WFM-MANAGEMENTINTERFACE-035"
    ],
    "description": "The desired-state manifest: served with and without an Accept header, with a quoted sha256 ETag and without `immutable` caching; `bundle` is null exactly when there are no deployments; a conditional request with the current ETag is answered 304.",
    "steps": [
      {
        "id": "wfm-core-ds-1",
        "name": "Retrieve Desired State With Explicit Accept Header — Content-Type And ETag Format",
        "crIds": [
          "MARGO-WFM-MANAGEMENTINTERFACE-004",
          "MARGO-WFM-MANAGEMENTINTERFACE-006",
          "MARGO-WFM-MANAGEMENTINTERFACE-027",
          "MARGO-WFM-MANAGEMENTINTERFACE-034"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "manifestVersion",
            "operation": "is_number"
          },
          {
            "field": "_headers.content-type",
            "operation": "equals",
            "value": "application/vnd.margo.manifest.v1+json"
          },
          {
            "field": "_headers.etag",
            "operation": "matches_regex",
            "value": "^\"sha256:[0-9a-f]{64}\"$"
          }
        ],
        "extract_context": {
          "manifestEtag": "_headers.etag",
          "bundleDigest": "bundle.digest",
          "deploymentId": "deployments.0.deploymentId",
          "deploymentDigest": "deployments.0.digest"
        }
      },
      {
        "id": "wfm-core-ds-bundle-field",
        "name": "Desired State: bundle Is null Exactly When There Are No Deployments",
        "crIds": [
          "MARGO-WFM-MANAGEMENTINTERFACE-009",
          "MARGO-WFM-MANAGEMENTINTERFACE-033"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "operation": "bundle_null_iff_no_deployments"
          }
        ],
        "extract_context": {}
      },
      {
        "id": "wfm-core-ds-not-immutable",
        "name": "Desired State Manifest Is Not Marked immutable",
        "crIds": [
          "MARGO-WFM-MANAGEMENTINTERFACE-035"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "_headers.cache-control",
            "operation": "not_contains",
            "value": "immutable"
          }
        ],
        "extract_context": {}
      },
      {
        "id": "wfm-core-ds-2",
        "name": "Retrieve Desired State Without An Accept Header — Defaults To Manifest Media Type",
        "crIds": [
          "MARGO-WFM-MANAGEMENTINTERFACE-007"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "_headers.content-type",
            "operation": "equals",
            "value": "application/vnd.margo.manifest.v1+json"
          }
        ],
        "extract_context": {}
      },
      {
        "id": "wfm-core-ds-3",
        "name": "Retrieve Desired State Again With Matching ETag — 304",
        "crIds": [
          "MARGO-WFM-MANAGEMENTINTERFACE-030"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json",
          "If-None-Match": "{manifestEtag}"
        },
        "expected_status": 304,
        "validations": [],
        "extract_context": {}
      }
    ]
  },
  {
    "id": "wfm-core-content-negotiation",
    "name": "WFM Content Negotiation — Unsupported Accept Header",
    "crIds": [
      "MARGO-WFM-MANAGEMENTINTERFACE-008"
    ],
    "description": "A request whose Accept header lists only media types the WFM does not serve is answered 406 with problem details.",
    "steps": [
      {
        "id": "wfm-core-cn-1",
        "name": "Request With Unsupported Accept Header Returns 406",
        "crIds": [
          "MARGO-WFM-MANAGEMENTINTERFACE-008"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/json"
        },
        "expected_status": 406,
        "validations": [
          {
            "field": "_headers.content-type",
            "operation": "contains",
            "value": "application/problem+json"
          },
          {
            "field": "type",
            "operation": "equals",
            "value": "https://docs.margo.org/specification/problem-types#server-cannot-generate-response"
          }
        ],
        "extract_context": {}
      }
    ]
  },
  {
    "id": "wfm-core-status",
    "name": "Deployment Status Reporting",
    "crIds": [
      "MARGO-WFM-MANAGEMENTINTERFACE-023"
    ],
    "description": "A status report for a deployment ID the WFM did not assign. The specification leaves the answer open, so the report may be accepted (200/201) or rejected as a semantic error (422); a server error or any other answer fails.",
    "steps": [
      {
        "id": "wfm-core-status-1",
        "name": "Status For A Deployment The WFM Did Not Assign — Accepted, Or Rejected As A Semantic Error (never a server error)",
        "method": "POST",
        "endpoint": "/api/v1/deployments/wfm-core-test-deployment/status",
        "mtls": true,
        "request_body": {
          "deploymentId": "wfm-core-test-deployment",
          "adoptedManifestVersion": 1,
          "status": {
            "state": "installed"
          },
          "components": [
            {
              "name": "wfm-core-component-1",
              "state": "installed"
            }
          ]
        },
        "headers": {},
        "expected_status": 200,
        "accepted_statuses": [
          201,
          422
        ],
        "validations": [],
        "extract_context": {},
        "crIds": [
          "MARGO-WFM-MANAGEMENTINTERFACE-023"
        ]
      }
    ]
  },
  {
    "id": "wfm-header-integrity-manifest",
    "name": "Desired State Manifest — ETag & Content-Type Correctness",
    "description": "Headers of the desired-state manifest: Content-Type, a quoted sha256 ETag that is the digest of the exact response body, the same ETag on a second read, and 304 with an empty body for a conditional request.",
    "crIds": [
      "MARGO-WFM-MANAGEMENTINTERFACE-004",
      "MARGO-WFM-MANAGEMENTINTERFACE-006",
      "MARGO-WFM-MANAGEMENTINTERFACE-015",
      "MARGO-WFM-MANAGEMENTINTERFACE-027",
      "MARGO-WFM-MANAGEMENTINTERFACE-030",
      "MARGO-WFM-MANAGEMENTINTERFACE-034",
      "MARGO-WFM-MANAGEMENTINTERFACE-036",
      "MARGO-WFM-MANAGEMENTINTERFACE-039"
    ],
    "steps": [
      {
        "id": "step-wfm-hi-1.1",
        "name": "Get Deployments — Manifest Has ETag, Content-Type, and a Valid Version",
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "manifestVersion",
            "operation": "greater_than",
            "value": 0
          },
          {
            "field": "_headers.content-type",
            "operation": "equals",
            "value": "application/vnd.margo.manifest.v1+json"
          },
          {
            "field": "_headers.etag",
            "operation": "exists"
          },
          {
            "field": "_headers.etag",
            "operation": "matches_regex",
            "value": "^\"sha256:[0-9a-f]{64}\"$"
          }
        ],
        "extract_context": {
          "etag": "_headers.etag"
        },
        "crIds": [
          "MARGO-WFM-MANAGEMENTINTERFACE-004",
          "MARGO-WFM-MANAGEMENTINTERFACE-006",
          "MARGO-WFM-MANAGEMENTINTERFACE-027",
          "MARGO-WFM-MANAGEMENTINTERFACE-034"
        ]
      },
      {
        "id": "step-wfm-hi-1.2",
        "name": "Get Deployments Again With If-None-Match — Returns 304 With Empty Body",
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json",
          "If-None-Match": "{etag}"
        },
        "expected_status": 304,
        "validations": [
          {
            "field": "_body",
            "operation": "equals",
            "value": ""
          }
        ],
        "extract_context": {},
        "crIds": [
          "MARGO-WFM-MANAGEMENTINTERFACE-030"
        ]
      },
      {
        "id": "step-wfm-hi-1.3",
        "name": "Manifest ETag Is The sha256 Digest Of The Exact Response Body",
        "crIds": [
          "MARGO-WFM-MANAGEMENTINTERFACE-015",
          "MARGO-WFM-MANAGEMENTINTERFACE-036"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "operation": "etag_is_body_digest"
          }
        ],
        "extract_context": {}
      },
      {
        "id": "step-wfm-hi-1.4",
        "name": "Manifest ETag Is Unchanged On A Second Read",
        "crIds": [
          "MARGO-WFM-MANAGEMENTINTERFACE-039"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "_headers.etag",
            "operation": "equals",
            "value": "{etag}"
          }
        ],
        "extract_context": {}
      }
    ]
  }
]
